<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:id="@+id/discount_code_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_accent"
        android:padding="@dimen/padding_medium"
        android:text="Available Discount Codes"
        android:textColor="@color/card_title"
        android:textSize="@dimen/text_size_extra_large"
        android:textStyle="bold" />

    <android.support.v4.widget.SwipeRefreshLayout
        android:layout_below="@id/discount_code_header"
        android:id="@+id/discount_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <android.support.v7.widget.RecyclerView
            android:id="@+id/list_discount_codes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </android.support.v4.widget.SwipeRefreshLayout>

    <ImageView
        android:id="@+id/img_no_discounts"
        android:layout_width="@dimen/item_image_view_extra_large"
        android:layout_height="@dimen/item_image_view_extra_large"
        android:layout_gravity="center"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/no_posts_margin"
        app:srcCompat="@drawable/ic_no_posts_grey_24dp"
        android:contentDescription="@string/sad_face"/>

    <TextView
        android:id="@+id/txt_no_discount_codes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_below="@+id/img_no_discounts"
        android:text="No Disount Codes!"
        android:textAppearance="?android:textAppearanceMedium" />
</RelativeLayout>
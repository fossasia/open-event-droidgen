<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:layout_width="match_parent"
    android:gravity="center_vertical"
    android:layout_height="wrap_content" android:padding="16dp">

    <ImageView
        android:id="@+id/imageView_color_track_schedule"
        android:background="@color/color_primary"
        android:layout_gravity="center_vertical"
        android:layout_width="4dp"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="16dp"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_title_event_schedule"
            android:text="Title"
            android:textStyle="bold"
            style="@style/TextAppearance.AppCompat.Body1"
            android:textSize="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_details_event_schedule"
            android:text="9:00 A.M. - 9:30 A.M. -- NUS Plug-in Blk 71"
            android:textSize="15dp"
            style="@style/TextAppearance.AppCompat.Body1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>


</LinearLayout>